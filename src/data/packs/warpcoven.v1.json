  "factionRules": [
    {
      "ruleId": "guiding_fates",
      "name": "Guiding Fates / 奸奇恩惠",
      "description": "为战斗选择每名巫师时，必须为其选择一项奸奇恩惠。每项奸奇恩惠每场战斗最多选择一次（整队不可重复）。九项恩惠见 effects（boon_*），在建队界面为每名巫师各选一项。"
    },
    {
      "ruleId": "astartes_warpcoven",
      "name": "Astartes / 阿斯塔特",
      "description": "每名己方次元密会阿斯塔特叛军特工在每次激活中可以执行两次射击行动或两次近战行动。若两次射击都选择灵魂收割者炮或亚空间火焰喷射器，第二次行动必须额外消耗 1AP。每次激活不能多次选择同一件灵能远程武器。每名己方次元密会阿斯塔特叛军特工无论命令为何都可以进行反应。"
    }
  ],
  "abilities": [
    {
      "abilityId": "fated_shield",
      "name": "Fated Shield / 天命庇护",
      "description": "独特行动（1AP，灵能）。选择对该特工可见的一名己方次元密会特工。直到该巫师下一次激活开始、被残废或任意己方特工再次执行本行动，以先发生者为准；每当一名特工向目标射击时，可以重掷任意己方防御骰。该巫师位于敌方控制范围内时不能执行此行动。"
    },
    {
      "abilityId": "trample_fate",
      "name": "Trample Fate / 蹂躏命运",
      "description": "独特行动（1AP，灵能）。选择该巫师 9\" 内且对其可见的一名敌方特工。持续时间与“天命庇护”相同。每当目标射击、近战或反击时，对手必须重掷结果为 6 的攻击骰；判断标识控制时，把目标 APL 视为低 1 点。这不是 APL 修改，所有其他 APL 变化均与本效果叠加。该巫师位于敌方控制范围内时不能执行此行动。"
    },
    {
      "abilityId": "ritual_of_reconstitution",
      "name": "Ritual of Reconstitution / 重构仪式",
      "description": "独特行动（1AP，灵能）。选择该巫师 6\" 内且对其可见的一名己方次元密会特工，目标回复最多 2D3 点已失去耐伤。该巫师位于敌方控制范围内，或本转折点已有任意己方特工执行过此行动时，不能执行。"
    },
    {
      "abilityId": "temporal_warp",
      "name": "Temporal Warp / 时空波动",
      "description": "独特行动（1AP，灵能）。选择该巫师 6\" 内且对其可见的一名己方次元密会特工，并把时空波动标识放在目标控制范围内。目标下一次激活结束时，若尚未残废且完全位于标识 6\" 内，则将其移出杀戮区并合法重新放置，使标识位于其控制范围内或尽可能靠近；随后移除标识。若目标不完全位于标识 6\" 内或已残废，则只移除标识。该巫师位于敌方控制范围内或己方时空波动标识已在杀戮区时，不能执行。注解：若目标在不能使用灵能附加规则的区域内开始或结束激活，时空波动都不能将其移除并重新放置。"
    },
    {
      "abilityId": "immolate_sanity",
      "name": "Immolate Sanity / 焚却理智",
      "description": "结算攻击骰时，若任意关键成功造成伤害，攻击目标获得己方焚却理智标识，持续至目标下一次激活结束、被残废或任意己方特工再次使用该武器，以先发生者为准。拥有标识的特工武器命中属性弱化 1，且不与受创叠加。"
    },
    {
      "abilityId": "illumination",
      "name": "Illumination / 点明",
      "description": "独特行动（1AP，灵能）。选择对该巫师可见的一名敌方特工。直到该巫师下一次激活开始、被残废或任意己方特工再次执行本行动，以先发生者为准，目标获得己方点明标识。己方次元密会特工向拥有标识的目标射击、近战或反击时，其武器获得无休（Ceaseless）。该巫师位于敌方控制范围内时不能执行。"
    },
    {
      "abilityId": "occult_automata",
      "name": "Occult Automata / 奥术自动机兵",
      "description": "该特工激活时，直到该次激活结束 APL 减少 1，除非一名己方次元密会巫师位于其 9\" 内。"
    },
    {
      "abilityId": "icon_bearer",
      "name": "Icon Bearer / 徽记持有者",
      "description": "判断标识控制时，把该特工 APL 视为高 1 点。这不是 APL 修改，其他变化均与本效果叠加。"
    },
    {
      "abilityId": "slow_and_purposeful",
      "name": "Slow and Purposeful / 缓慢而坚定",
      "description": "该特工射击时，若本次激活尚未执行冲锋或转移，或正在进行反应，则远程武器获得无休。该规则不阻止它在射击后执行这些移动行动。"
    },
    {
      "abilityId": "bestial_rage",
      "name": "Bestial Rage / 野性狂暴",
      "description": "每次激活中首次执行近战行动后，若该特工未被残废，可以立即无消耗再执行一次近战行动，且不必选择同一敌方特工。本规则优先于行动限制。"
    },
    {
      "abilityId": "blasted_horn",
      "name": "Blasted Horn / 兽群号角",
      "description": "独特行动（0AP）。直到下一战略阶段的就绪步骤，为己方次元密会奸角兽特工的移动属性增加 1\"。该特工位于敌方控制范围内时不能执行。"
    },
    {
      "abilityId": "herd_banner",
      "name": "Herd Banner / 兽群旗帜",
      "description": "每当该特工 3\" 内且对其可见的一名己方次元密会奸角兽特工因一枚攻击骰受到 3 点或以上的普通伤害时，伤害减少 1 点。"
    },
    {
      "abilityId": "relic_hunter",
      "name": "Relic Hunter / 神器猎人",
      "description": "每场战斗限一次。当一名己方奸角兽战士完全位于对手领地内时，可以让它执行拾取标识、放置标识或任务行动少消耗 1AP。"
    },
    {
      "abilityId": "shield",
      "name": "Shield / 盾牌",
      "description": "选择该武器时，该特工豁免为 4+；使用该武器近战或反击时，每次格挡可以格挡两个未结算成功。"
    }
  ],
